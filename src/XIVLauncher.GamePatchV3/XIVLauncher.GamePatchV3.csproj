<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Product>XIVLauncher Game Patch V3</Product>
        <AssemblyTitle>XIVLauncher Game Patch V3</AssemblyTitle>
        <Description>Core game patching operations: update, integrity check, repair, fresh install.</Description>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>

    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Serilog"/>





    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\XIVLauncher.Common\XIVLauncher.Common.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="XIVLauncher.Linux.Tests"/>
    </ItemGroup>
</Project>
